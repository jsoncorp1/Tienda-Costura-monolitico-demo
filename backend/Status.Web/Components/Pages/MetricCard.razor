<div style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); position: relative; overflow: hidden; transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
        <h4 style="margin: 0; color: var(--text-light); font-size: 0.95rem; font-weight: 500;">@Title</h4>
        <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(198, 106, 74, 0.1); display: flex; align-items: center; justify-content: center; color: var(--accent);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (Icon == "dollar-sign") { <line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path> }
                @if (Icon == "file-text") { <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline> }
                @if (Icon == "users") { <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path> }
                @if (Icon == "activity") { <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline> }
            </svg>
        </div>
    </div>
    
    <div style="display: flex; align-items: baseline; gap: 10px;">
        <h2 style="margin: 0; font-size: 1.8rem; color: var(--text);">@Value</h2>
        <span style="font-size: 0.85rem; font-weight: 600; color: @(Trend.StartsWith("+") ? "#006644" : "#D93025"); background: @(Trend.StartsWith("+") ? "#E3FCEF" : "#FCE8E6"); padding: 2px 8px; border-radius: 10px;">
            @Trend
        </span>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Trend { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
}
