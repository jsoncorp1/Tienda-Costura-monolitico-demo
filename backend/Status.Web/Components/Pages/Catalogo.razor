@page "/catalogo"
@rendermode InteractiveServer
@using Status.Infrastructure.Persistencia
@using Status.Domain.Entidades
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Catálogo - STATUS</PageTitle>

<div style="background: var(--secondary); min-height: 100vh; padding-bottom: 100px;">
    
    <!-- Buscador Superior -->
    <div style="background: var(--primary); padding: 40px 5%; display: flex; justify-content: center;">
        <div style="position: relative; width: 100%; max-width: 600px;">
            <svg style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--text-light);" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            
            <input type="text" placeholder="Buscar por nombre o descripción..." @bind="SearchTerm" @bind:event="oninput"
                   style="width: 100%; padding: 18px 20px 18px 55px; border-radius: 30px; border: none; font-size: 1.1rem; outline: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15); color: var(--text);" />
        </div>
    </div>

    <!-- Filtros por Categoría -->
    <div style="padding: 25px 5% 0; max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;">
        <button @onclick='() => SelectedCategory = ""'
                style="@CategoryStyle("")">
            Todos
        </button>
        @foreach (var cat in Categories)
        {
            <button @onclick='() => SelectedCategory = cat'
                    style="@CategoryStyle(cat)">
                @cat
            </button>
        }
    </div>

    <!-- Grid de Productos -->
    <div style="padding: 40px 5% 60px; max-width: 1200px; margin: 0 auto;">
        
        @if (Loading)
        {
            <div style="text-align: center; padding: 80px 20px; color: var(--text-light);">
                <h2 style="font-size: 1.5rem; color: var(--primary);">Cargando catálogo...</h2>
            </div>
        }
        else if (!FilteredCatalog.Any())
        {
            <div style="text-align: center; padding: 80px 20px; color: var(--text-light);">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="margin-bottom: 20px; opacity: 0.5;">
                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <h2 style="font-size: 1.5rem; color: var(--primary);">No se encontraron productos</h2>
                <p>Intenta buscar con otros términos.</p>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px;">
                @foreach (var prod in FilteredCatalog)
                {
                    <a href="/producto/@prod.Slug" class="glass-panel" style="padding: 0; cursor: pointer; display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--border); text-decoration: none; color: inherit;">
                        
                        <div style="width: 100%; aspect-ratio: 4/3; background: #F8F9FA; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                             <img src="@prod.ImagenUrl" alt="@prod.Nombre" 
                                  style="width: 100%; height: 100%; object-fit: contain; padding: 20px; transition: transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);" 
                                  onmouseover="this.style.transform='scale(1.08)'"
                                  onmouseout="this.style.transform='scale(1)'" />
                             
                             <div style="position: absolute; top: 20px; left: 20px; background: rgba(31, 78, 95, 0.9); padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; color: white; backdrop-filter: blur(5px);">
                                 Bs. @prod.PrecioLista
                             </div>
                        </div>
                        
                        <div style="padding: 25px; display: flex; flex-direction: column; flex-grow: 1; background: white;">
                            <span style="font-size: 0.9rem; color: var(--accent); font-weight: 800; margin-bottom: 8px; letter-spacing: 0.5px;">@prod.Nombre</span>
                            <h3 style="font-size: 1.1rem; color: var(--primary); margin-bottom: 20px; line-height: 1.3;">@prod.Descripcion</h3>
                            
                            <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 15px;">
                                <span style="font-size: 0.9rem; color: var(--text-light); font-weight: 500; display: flex; align-items: center; gap: 5px;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    Personalizable
                                </span>
                                <div class="catalog-btn" style="width: 40px; height: 40px; border-radius: 50%; background: var(--secondary); color: var(--primary); display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <style>
        .glass-panel:hover .catalog-btn {
            background: var(--primary) !important;
            color: white !important;
            transform: translateX(5px);
        }
    </style>
</div>

@code {
    private bool Loading = true;
    private List<Producto> AllCatalog = new();
    private string searchTerm = "";
    private string SelectedCategory = "";
    
    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
        }
    }

    // Extract categories from product names
    private List<string> Categories => AllCatalog
        .Select(p => DetectCategory(p.Nombre))
        .Where(c => !string.IsNullOrEmpty(c))
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private string DetectCategory(string nombre)
    {
        var n = nombre.ToLower();
        if (n.Contains("mochila")) return "Mochilas";
        if (n.Contains("billetera")) return "Billeteras";
        if (n.Contains("chamarra") || n.Contains("chaqueta")) return "Chamarras";
        if (n.Contains("maletín") || n.Contains("maletin")) return "Maletines";
        return "Otros";
    }

    private IEnumerable<Producto> FilteredCatalog
    {
        get
        {
            var items = AllCatalog.AsEnumerable();
            
            if (!string.IsNullOrWhiteSpace(SelectedCategory))
                items = items.Where(p => DetectCategory(p.Nombre) == SelectedCategory);
            
            if (!string.IsNullOrWhiteSpace(SearchTerm))
                items = items.Where(p => p.Nombre.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || 
                                         p.Descripcion.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            return items;
        }
    }

    private string CategoryStyle(string cat)
    {
        var isActive = cat == SelectedCategory;
        return isActive
            ? "background: var(--primary); color: white; border: 2px solid var(--primary); padding: 10px 24px; border-radius: 25px; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.3s ease;"
            : "background: white; color: var(--text); border: 2px solid var(--border); padding: 10px 24px; border-radius: 25px; font-weight: 500; font-size: 0.95rem; cursor: pointer; transition: all 0.3s ease;";
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        
        AllCatalog = await context.Productos.ToListAsync();
        
        if (!AllCatalog.Any())
        {
            AllCatalog = new List<Producto>
            {
                new Producto { Nombre = "ST1024", Slug = "st1024", ImagenUrl = "/images/1.jpg", Descripcion = "Mochila Premium", PrecioLista = 120.00m, SoloMayorista = false },
                new Producto { Nombre = "ST1032 Mochila con Zapatero", Slug = "st1032-zapatero", ImagenUrl = "/images/2.jpg", Descripcion = "Mochila Deportiva", PrecioLista = 150.00m, SoloMayorista = false },
                new Producto { Nombre = "ST1033 Mochila con Zapatero", Slug = "st1033-zapatero", ImagenUrl = "/images/3.jpg", Descripcion = "Mochila Deportiva", PrecioLista = 155.00m, SoloMayorista = false },
                new Producto { Nombre = "ST1016 Mochila Deportiva", Slug = "st1016-deportiva", ImagenUrl = "/images/4.jpg", Descripcion = "Mochila Ligera", PrecioLista = 90.00m, SoloMayorista = false },
                new Producto { Nombre = "Billeteras STATUS", Slug = "billeteras-status", ImagenUrl = "/images/5.jpg", Descripcion = "Cuero sintético", PrecioLista = 40.00m, SoloMayorista = false },
                new Producto { Nombre = "ST1008 Mochila STATUS", Slug = "st1008-mochila", ImagenUrl = "/images/6.jpg", Descripcion = "Mochila Ejecutiva", PrecioLista = 135.00m, SoloMayorista = false }
            };
            
            context.Productos.AddRange(AllCatalog);
            await context.SaveChangesAsync();
        }
        
        Loading = false;
    }
}
