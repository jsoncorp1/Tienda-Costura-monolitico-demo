        </div>
        
        <div class="glass-panel" style="background: var(--secondary);">
            <div style="width: 50px; height: 50px; background: var(--primary); color: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 style="font-size: 1.4rem; margin-bottom: 15px;">Entregas a Tiempo</h3>
            <p style="color: var(--text-light); line-height: 1.6;">Nuestra capacidad de producción instalada nos permite cumplir con grandes volúmenes en tiempos récord.</p>
        </div>
        
        <div class="glass-panel" style="background: var(--secondary);">
            <div style="width: 50px; height: 50px; background: var(--primary); color: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <h3 style="font-size: 1.4rem; margin-bottom: 15px;">Atención Personalizada</h3>
            <p style="color: var(--text-light); line-height: 1.6;">Un ejecutivo te acompañará desde la cotización hasta la entrega final de tu producto corporativo.</p>
        </div>
    </div>
</div>

@code {
    private int currentImage = 0;
    private string[] carouselImages = new[] { "/images/banner1.jpg", "/images/banner2.jpg", "/images/banner3.jpg" };
    private CancellationTokenSource? _cts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Posicionar el carrusel al slide inicial via JS
            await MoveCarousel();
            _cts = new CancellationTokenSource();
            _ = AutoAdvance(_cts.Token);
        }
    }

    private async Task MoveCarousel()
    {
        // Mueve el track del carrusel via JS interop - garantiza que la transición CSS funcione
        double pct = currentImage * (100.0 / 3.0);
        await JS.InvokeVoidAsync("eval",
            $"var el = document.getElementById('carousel-track'); if(el) el.style.transform = 'translateX(-{pct.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%)';");
    }

    private async Task AutoAdvance(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            await Task.Delay(4500, token).ContinueWith(_ => { });
            if (!token.IsCancellationRequested)
            {
                currentImage = (currentImage + 1) % carouselImages.Length;
                await InvokeAsync(async () =>
                {
                    StateHasChanged();
                    await MoveCarousel();
                });
            }
        }
    }

    private async Task NextSlide()
    {
        currentImage = (currentImage + 1) % carouselImages.Length;
        await MoveCarousel();
        ResetTimer();
    }

    private async Task PrevSlide()
    {
        currentImage = (currentImage - 1 + carouselImages.Length) % carouselImages.Length;
        await MoveCarousel();
        ResetTimer();
    }

    private async Task GoToSlide(int index)
    {
        currentImage = index;
        await MoveCarousel();
        ResetTimer();
    }

    private void ResetTimer()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = AutoAdvance(_cts.Token);
    }

    public void Dispose()
    {
        _cts?.Cancel();
    }
}
