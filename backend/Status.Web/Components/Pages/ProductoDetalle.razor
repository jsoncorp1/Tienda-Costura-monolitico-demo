@page "/producto/{Slug}"
@rendermode InteractiveServer
@using Status.Infrastructure.Persistencia
@using Status.Domain.Entidades
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>@(Producto?.Nombre ?? "Cargando...") - STATUS</PageTitle>

<div style="background: var(--secondary); min-height: 100vh; padding: 0 5% 80px; font-family: 'Inter', sans-serif;">
    
    <!-- Breadcrumb -->
    <div style="padding: 20px 0; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--text-light); max-width: 1200px; margin: 0 auto;">
        <a href="/" style="color: var(--text-light); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-light)'">Inicio</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <a href="/catalogo" style="color: var(--text-light); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-light)'">Catálogo</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <span style="color: var(--primary); font-weight: 600;">@(Producto?.Nombre ?? Slug)</span>
    </div>

    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 40px;">
        
        @if (Loading)
        {
            <div style="width: 100%; text-align: center; padding: 100px;">
                <h2 style="color: var(--primary);">Cargando detalles...</h2>
            </div>
        }
        else if (Producto == null)
        {
            <div style="width: 100%; text-align: center; padding: 100px;">
                <h2 style="color: var(--primary);">Producto no encontrado</h2>
                <a href="/catalogo" class="btn-primary" style="margin-top: 20px;">Volver al Catálogo</a>
            </div>
        }
        else
        {
            <!-- Galería de imágenes (Izquierda) -->
            <div style="flex: 1; min-width: 350px;">
                <div style="background: white; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                    <div style="width: 100%; aspect-ratio: 1/1; background: #F8F9FA; display: flex; align-items: center; justify-content: center; padding: 40px;">
                        <img src="@Producto.ImagenUrl" alt="@Producto.Nombre" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                </div>
            </div>

            <!-- Detalles del Producto (Derecha) -->
            <div style="flex: 1.2; min-width: 350px; display: flex; flex-direction: column; gap: 20px; background: white; padding: 40px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid var(--border);">
                
                <div>
                    <h1 style="color: var(--primary); font-size: 2.2rem; margin: 0 0 10px 0; font-weight: 800; letter-spacing: -0.5px;">@Producto.Nombre</h1>
                    <div style="display: flex; gap: 15px; color: var(--text-light); font-size: 0.95rem; font-weight: 500;">
                        <span><strong>Código:</strong> @ExtraerCodigo(Producto.Nombre)</span>
                        <span>|</span>
                        <span><strong>Categoría:</strong> @ExtraerCategoria(Producto.Nombre)</span>
                    </div>
                </div>

                <div style="font-size: 1.8rem; font-weight: 800; color: var(--accent);">
                    Bs. @Producto.PrecioLista
                </div>

                <div>
                    <h3 style="color: var(--text); font-size: 1.1rem; margin: 0 0 10px 0;">Características:</h3>
                    <p style="color: var(--text-light); line-height: 1.6; margin: 0 0 15px 0;">@Producto.Descripcion</p>
                    <ul style="color: var(--text-light); line-height: 1.6; padding-left: 20px; margin: 0;">
                        <li>Material de alta resistencia</li>
                        <li>Colores disponibles: Negro, Azul, Gris, Rojo</li>
                        <li>Acabados premium y costuras reforzadas</li>
                    </ul>
                </div>

                <hr style="border: 0; border-top: 1px solid var(--border); margin: 10px 0;" />

                <!-- Seleccionador de Cantidad -->
                <div>
                    <h3 style="color: var(--text); font-size: 1.1rem; margin: 0 0 10px 0;">Cantidad:</h3>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <div style="display: flex; align-items: center; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; width: 140px;">
                            <button @onclick="DecrementarCantidad" style="flex: 1; padding: 10px; border: none; background: #F8F9FA; cursor: pointer; font-size: 1.2rem; font-weight: bold; color: var(--text); transition: background 0.2s;" onmouseover="this.style.background='#e9ecef'" onmouseout="this.style.background='#F8F9FA'">-</button>
                            <input type="number" @bind="Cantidad" @bind:event="oninput" min="1" style="flex: 1; width: 50px; text-align: center; border: none; border-left: 1px solid var(--border); border-right: 1px solid var(--border); font-size: 1.1rem; font-weight: bold; outline: none; -moz-appearance: textfield;" />
                            <button @onclick="IncrementarCantidad" style="flex: 1; padding: 10px; border: none; background: #F8F9FA; cursor: pointer; font-size: 1.2rem; font-weight: bold; color: var(--text); transition: background 0.2s;" onmouseover="this.style.background='#e9ecef'" onmouseout="this.style.background='#F8F9FA'">+</button>
                        </div>
                    </div>
                </div>

                <!-- Opciones de Personalización -->
                <div style="background: #F8F9FA; padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
                    <h3 style="color: var(--text); font-size: 1.1rem; margin: 0 0 15px 0; display: flex; align-items: center; gap: 8px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                        ¿Quieres personalizarla?
                    </h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--text); font-weight: 500;">
                            <input type="checkbox" @bind="RequiereLogo" style="width: 18px; height: 18px; accent-color: var(--primary);" /> Logo propio
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--text); font-weight: 500;">
                            <input type="checkbox" @bind="RequiereBordado" style="width: 18px; height: 18px; accent-color: var(--primary);" /> Bordado
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--text); font-weight: 500;">
                            <input type="checkbox" @bind="RequiereDtf" style="width: 18px; height: 18px; accent-color: var(--primary);" /> Estampado DTF
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--text); font-weight: 500;">
                            <input type="checkbox" @bind="RequiereSublimado" style="width: 18px; height: 18px; accent-color: var(--primary);" /> Sublimado
                        </label>
                    </div>
                </div>

                <!-- Call to Actions -->
                <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 10px;">
                    <button @onclick="IrACotizacionCorporativa" class="btn-primary" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 10px; font-size: 1.1rem; padding: 16px;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        SOLICITAR COTIZACIÓN
                    </button>
                    
                    <a href="@GenerarEnlaceWhatsApp()" target="_blank" class="btn-secondary" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 10px; font-size: 1.1rem; padding: 16px; background: white; border: 2px solid #25D366; color: #25D366;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        CONSULTAR POR WHATSAPP
                    </a>
                </div>

                <!-- Banner B2B -->
                <div style="background: rgba(31, 78, 95, 0.05); border-left: 4px solid var(--primary); padding: 15px 20px; border-radius: 0 8px 8px 0; margin-top: 10px;">
                    <p style="margin: 0; color: var(--primary); font-weight: 600; font-size: 1rem;">¿Necesitas más de 20 unidades?</p>
                    <p style="margin: 5px 0 0 0; color: var(--text-light); font-size: 0.95rem;">Solicita un precio especial por volumen y accede a nuestras tarifas para mayoristas y empresas.</p>
                </div>
                
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private bool Loading = true;
    private Producto? Producto;
    
    // Estado de la UI
    private int Cantidad = 1;
    private bool RequiereLogo = false;
    private bool RequiereBordado = false;
    private bool RequiereDtf = false;
    private bool RequiereSublimado = false;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        Producto = await context.Productos.FirstOrDefaultAsync(p => p.Slug == Slug);
        Loading = false;
    }

    private void IncrementarCantidad() => Cantidad++;
    private void DecrementarCantidad()
    {
        if (Cantidad > 1) Cantidad--;
    }

    private string ExtraerCodigo(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "N/A";
        var parts = nombreCompleto.Split(' ');
        return parts.Length > 0 ? parts[0] : "N/A";
    }

    private string ExtraerCategoria(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "General";
        if (nombreCompleto.ToLower().Contains("mochila")) return "Mochilas";
        if (nombreCompleto.ToLower().Contains("billetera")) return "Billeteras";
        if (nombreCompleto.ToLower().Contains("bolso")) return "Bolsos";
        return "Ropa / Accesorios";
    }

    private void IrACotizacionCorporativa()
    {
        // Navegamos al portal corporativo pasando el slug como parámetro
        NavigationManager.NavigateTo($"/empresas?producto={Slug}&qty={Cantidad}");
    }

    private string GenerarEnlaceWhatsApp()
    {
        if (Producto == null) return "https://wa.me/59171923455";
        
        var personalizaciones = new List<string>();
        if (RequiereLogo) personalizaciones.Add("Logo propio");
        if (RequiereBordado) personalizaciones.Add("Bordado");
        if (RequiereDtf) personalizaciones.Add("Estampado DTF");
        if (RequiereSublimado) personalizaciones.Add("Sublimado");
        
        string personalizacionStr = personalizaciones.Any() ? string.Join(", ", personalizaciones) : "Sin personalización extra";

        string mensaje = $"Hola STATUS! Me interesa el producto: {Producto.Nombre} (Código: {ExtraerCodigo(Producto.Nombre)}).\n" +
                         $"* Cantidad: {Cantidad}\n" +
                         $"* Personalización: {personalizacionStr}\n\n" +
                         $"¿Me podrían dar más información?";

        return $"https://wa.me/59171923455?text={Uri.EscapeDataString(mensaje)}";
    }
}
